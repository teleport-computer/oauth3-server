# Owner secret — extension uses it to sync jars and to mint scoped tokens.
# Generate: openssl rand -hex 32
#
# IMPORTANT (#143): keep the line below COMMENTED OUT. Deno's --env-file keeps the FIRST
# occurrence of a key, so a blank `OWNER_SECRET=` here would shadow the real value you append
# to .env and the server would silently run with an empty secret. Generate + append instead:
#   echo "OWNER_SECRET=$(openssl rand -hex 32)" >> .env
# OWNER_SECRET=

# Seals the cookie vault at rest (AES-GCM). 32-byte hex: openssl rand -hex 32.
# Dev: a throwaway value here. Prod: the daemon derives + injects this per-app
# (dstack GetKey → HKDF, via the isolated-container argv) — NOT committed.
#
# IMPORTANT (#143): keep this COMMENTED OUT too — same --env-file first-occurrence shadowing
# risk as OWNER_SECRET. Generate + append instead:
#   echo "SEAL_KEY=$(openssl rand -hex 32)" >> .env
# SEAL_KEY=

# Background poller cadence (minutes). Default 30.
POLL_INTERVAL_MIN=30

PORT=3000
DATA_DIR=./data
